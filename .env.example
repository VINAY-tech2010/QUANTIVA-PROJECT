# ── calkulater environment ─────────────────────────────────────────────────────
# Copy to .env.local and adjust. Never commit real secrets.

# Exchange-rate provider. "frankfurter" (default, free, no key) or "fallback".
FX_PROVIDER=frankfurter

# Base URL for the FX provider (override for self-hosted / testing).
# FX_BASE_URL=https://api.frankfurter.dev

# Optional API key if you switch to a provider that requires one.
# FX_API_KEY=

# How long to cache exchange-rate tables server-side, in seconds.
FX_CACHE_TTL_SECONDS=3600

# Public site URL used for SEO canonical/OG tags and the sitemap.
# Production default is https://calkulater.bond (set explicitly to override).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Feedback / contact email delivery (server-side only) ─────────────────────
# Required to enable delivery. The owner inbox that receives feedback,
# complaints, and contact messages.
FEEDBACK_TO_EMAIL=

# Sender address. Provider-dependent; for Resend use a verified domain sender.
FEEDBACK_FROM_EMAIL=

# Which email transport to use: "resend" or "smtp-webhook". Optional — if unset
# (or misconfigured) the transport whose credentials are present is selected
# automatically, so a Cloudflare worker that only received the API key secret
# still delivers via Resend.
EMAIL_PROVIDER=resend

# API key for the chosen provider (e.g. Resend). Server-side secret, never
# NEXT_PUBLIC_*. On Cloudflare Workers store it as a worker secret, not a plain
# var, so it never lands in client bundles or build artifacts:
#   wrangler secret put EMAIL_PROVIDER_API_KEY
# (Cloudflare dashboard: Workers & Pages → your worker → Settings → Variables
# and Secrets → Secrets.)
EMAIL_PROVIDER_API_KEY=

# Generic webhook endpoint (used when EMAIL_PROVIDER=smtp-webhook). The endpoint
# receives a JSON POST: { to, from, subject, text, html, replyTo }.
FEEDBACK_SMTP_URL=

# ── Advertising (Google AdSense) — public values, safe to expose ─────────────
# Leave empty to keep ad slots as graceful placeholders (no network calls).
# Your AdSense publisher/client ID, e.g. ca-pub-1234567890123456.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Ad-unit slot IDs per placement (create ad units in the AdSense console).
# Leave any empty to keep that placement as a graceful placeholder.
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_RAIL=
NEXT_PUBLIC_ADSENSE_SLOT_INCONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
